evidence/E1/*.log export-ignore
evidence/E2/*.log export-ignore
evidence/E2B/*.log export-ignore
evidence/E2C/*.log export-ignore
evidence/E2D/*.log export-ignore
evidence/E2E/*.log export-ignore
app/src/test/resources/*.bin binary
