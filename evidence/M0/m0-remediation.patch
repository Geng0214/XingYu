new file mode 100644
index 00000000..2e6144ac
--- /dev/null
+++ b/ci/script/build_m0_local.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+# M0 本地可复现构建（Windows / Git Bash）
+#
+# 为什么存在：计划书 M0-T02 要求"依照同一清单完成两次构建"，所以上面的每一步都必须
+# 是显式的、可抄写的，而不是某次会话里凑出来的命令。
+#
+# 关键前提（均为实测得出，不要凭印象改）：
+#   - JDK 必须是 21。CI (.github/workflows/android-build.yml 的 JAVA_VERSION) 与
+#     docs/doc-src/dev-core/BUILDING.md 都钉 21；本机默认 JAVA_HOME 是 jdk-17。
+#   - 外部依赖归档必须先经 ci/script/prepare_android_dependencies.py 解包，
+#     否则 :app:compileCloneAidl 会因缺 app/libs/ffmpeg-kit-local.aar 失败。
+#   - Bash 不继承交互 shell 的代理设置。三个依赖归档来自 Google Drive、STT 资产来自
+#     Hugging Face，不设 https_proxy 会表现为"资源不可得"，实测是环境问题。
+#     直连 huggingface.co 本机实测超时（curl 返回 000），所以代理是构建前置条件。
+#   - STT 资产由 :syncSttModelAssets 用 HttpURLConnection 下载，URL 写死在
+#     app/config/stt-model-assets.properties 的第 2 字段，没有可覆盖的 Gradle 属性；
+#     HttpURLConnection 只认 JVM 的 https.proxyHost/https.proxyPort，不认 https_proxy
+#     环境变量，因此必须把代理翻译进 org.gradle.jvmargs。
+#   - org.gradle.caching/parallel/configureondemand 与 kotlin.incremental 在 Windows 上
+#     会触发 Kotlin 增量缓存 AccessDeniedException 与 Gradle 临时文件
+#     FileNotFoundException，因此在 GRADLE_USER_HOME 的用户级 gradle.properties 中关闭。
+#     用户级属性优先于工程级，这样不必改动上游跟踪的 gradle.properties。
+set -euo pipefail
+
+WORK_ROOT="${WORK_ROOT:-C:/Users/15942/Desktop/Work}"
+REPO="${REPO:-$WORK_ROOT/operit}"
+GRADLE_USER_HOME="${GRADLE_USER_HOME:-$WORK_ROOT/.gradle-m0}"
+ANDROID_HOME="${ANDROID_HOME:-C:/Users/15942/dev/sdk/android-sdk}"
+JAVA_HOME="${BUILD_JAVA_HOME:-C:/Users/15942/dev/jdk-21}"
+GRADLE_TASK="${GRADLE_TASK:-assembleDebugClone}"
+
+export ANDROID_HOME JAVA_HOME
+export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"
+export GRADLE_USER_HOME
+
+# 本机交互环境的 JAVA_HOME 指向 C:\DevTools\jdk-17，默认 java 也是 17。
+# 计划书与 CI 钉的是 21，且依赖 io.github.kyant0:backdrop:1.0.6 的 class 文件版本为 65.0，
+# 用 17 会在 :app:kaptCloneKotlin 报 "class file has wrong version 65.0, should be 61.0"。
+# 因此这里不做默认继承，而是显式校验；版本不符就停止，让清单可证伪。
+java_major="$("$JAVA_HOME/bin/java" -version 2>&1 | sed -n '1s/.*version "\([0-9]*\).*/\1/p')"
+if [ "$java_major" != "21" ]; then
+  echo "JAVA_HOME=$JAVA_HOME 解析到 JDK ${java_major:-未知}，本清单要求 21" >&2
+  exit 1
+fi
+test -d "$ANDROID_HOME/platforms/android-36" || { echo "ANDROID_HOME=$ANDROID_HOME 缺 android-36 平台" >&2; exit 1; }
+
+# 代理是构建前置条件：把 https_proxy 的 host:port 交给 JVM。
+https_proxy="${https_proxy:-${HTTPS_PROXY:-}}"
+proxy_authority="${https_proxy#*://}"
+proxy_authority="${proxy_authority%%/*}"
+proxy_host="${proxy_authority%%:*}"
+proxy_port="${proxy_authority##*:}"
+if [ -z "$proxy_host" ] || [ "$proxy_host" = "$proxy_authority" ]; then
+  echo "需要 https_proxy（形如 http://127.0.0.1:7897）：依赖归档与 STT 资产无法直连获取" >&2
+  exit 1
+fi
+
+export ANDROID_HOME JAVA_HOME
+export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"
+export GRADLE_USER_HOME
+
+mkdir -p "$GRADLE_USER_HOME"
+
+# 用户级覆盖：只关并发与缓存，不动任何产品行为开关。
+cat > "$GRADLE_USER_HOME/gradle.properties" <<EOF
+org.gradle.jvmargs=-Xmx8192m -Dfile.encoding=UTF-8 -Dhttps.proxyHost=$proxy_host -Dhttps.proxyPort=$proxy_port -Dhttp.proxyHost=$proxy_host -Dhttp.proxyPort=$proxy_port
+org.gradle.parallel=false
+org.gradle.caching=false
+org.gradle.configureondemand=false
+org.gradle.daemon=false
+org.gradle.workers.max=4
+kotlin.incremental=false
+EOF
+
+cd "$REPO"
+test -f local.properties || { echo "local.properties 缺失：需 sdk.dir" >&2; exit 1; }
+test -f app/libs/ffmpeg-kit-local.aar || { echo "缺 app/libs/ffmpeg-kit-local.aar：先跑 prepare_android_dependencies.py" >&2; exit 1; }
+test -s app/src/main/jniLibs/arm64-v8a/liboperit_ripgrep.so || { echo "缺 liboperit_ripgrep.so" >&2; exit 1; }
+
+./gradlew "$GRADLE_TASK" \
+  --no-daemon \
+  --console=plain \
+  --stacktrace
