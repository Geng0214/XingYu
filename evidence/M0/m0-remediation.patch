+#!/usr/bin/env bash
+# 计划书 M0-A01：把"冻结基线"物化成一个不含 .git、不含开发目录遗留状态的可构建工作区。
+#
+# 基线由五部分构成，缺一不可，本脚本逐项断言：
+#   1. 主仓库 commit            BASE_COMMIT
+#   2. terminal 子模块 commit   TERMINAL_COMMIT
+#   3. 主仓库源码补丁            evidence/M0/m0-remediation.patch
+#   4. 子模块源码补丁            evidence/M0/terminal-m0-remediation.patch
+#   5. 三个外部归档（按 SHA-256 校验，缓存缺失才下载）
+#
+# 刻意不复用上游 ci/script/download_android_dependencies.sh：它依赖 gdown + pip 联网，
+# 且不校验字节；本脚本用钉死的 SHA-256 做同等或更强的保证。上游解包器
+# prepare_android_dependencies.py（含 zip 炸弹/路径穿越/加密成员防护）照常使用。
+#
+# 用法：M0 之外不要运行。CLEAN_DIR 必须不存在或为空。
+set -euo pipefail
+
+WORK_ROOT="${WORK_ROOT:-C:/Users/15942/Desktop/Work}"
+REPO="${REPO:-$WORK_ROOT/operit}"
+CLEAN_DIR="${1:?用法: materialize_m0_clean.sh <干净目录路径>}"
+
+BASE_COMMIT="${BASE_COMMIT:-31646978aa03520f36916a9efd1d3f508b5ca3e0}"
+TERMINAL_COMMIT="${TERMINAL_COMMIT:-045868988e4091d613cb34b2941057703899b96e}"
+PATCH="$REPO/evidence/M0/m0-remediation.patch"
+TERMINAL_PATCH="$REPO/evidence/M0/terminal-m0-remediation.patch"
+ARCHIVE_CACHE="${ARCHIVE_CACHE:-$WORK_ROOT/manual-deps-cache}"
+
+# 与 evidence/M0/build-manifest.json 的 externalInputs.archives 一一对应。
+DRIVE_IDS="libs.zip:1Va1os7PRpCF3xtTwfx5kO11D7eIAvARG subpack.zip:1SQs_dVPD6ldvwteqoUVjvBLjTWvr5Fpv jniLibs.zip:1-W4fjjUwoShnB8Rh9RT5Gl8sHiGyQUaM"
+EXPECTED_SHA="libs.zip:1625489c81bb6e3ec6d29d41c39a53cb985e997be474425be01f909a6df887f8 subpack.zip:2953448c93b0e4e51a6434b96b0145af271efdf07bf99a54b24925727c8545ae jniLibs.zip:2e8a4efd78b4b9daf3274ee17ba38eb5f42fb57bf43381b63c55aaa1d3148b53"
+
+for required in "$PATCH" "$TERMINAL_PATCH" "$REPO/local.properties"; do
+  test -f "$required" || { echo "缺少基线输入：$required" >&2; exit 1; }
+done
+
+if [ -e "$CLEAN_DIR" ] && [ -n "$(ls -A "$CLEAN_DIR" 2>/dev/null)" ]; then
+  echo "拒绝写入非空目录：$CLEAN_DIR" >&2
+  exit 1
+fi
+mkdir -p "$CLEAN_DIR"
+
+echo "=== 1/5 主仓库 $BASE_COMMIT ==="
+git -C "$REPO" cat-file -e "${BASE_COMMIT}^{commit}"
+git -C "$REPO" archive --format=tar "$BASE_COMMIT" | tar -x -C "$CLEAN_DIR"
+
+echo "=== 2/5 terminal 子模块 $TERMINAL_COMMIT ==="
+# 子模块的 .git 是 gitlink 文件，不是目录。
+test -e "$REPO/terminal/.git" || { echo "开发目录的 terminal 子模块未初始化" >&2; exit 1; }
+git -C "$REPO/terminal" cat-file -e "${TERMINAL_COMMIT}^{commit}"
+# 超级项目的 git archive 完全不含子模块内容，连目录都不会建。
+mkdir -p "$CLEAN_DIR/terminal"
+git -C "$REPO/terminal" archive --format=tar "$TERMINAL_COMMIT" | tar -x -C "$CLEAN_DIR/terminal"
+
+echo "=== 3/5 应用源码补丁 ==="
+git -C "$CLEAN_DIR" apply --binary --check "$PATCH"
+git -C "$CLEAN_DIR" apply --binary "$PATCH"
+git -C "$CLEAN_DIR/terminal" apply --binary --check "$TERMINAL_PATCH"
+git -C "$CLEAN_DIR/terminal" apply --binary "$TERMINAL_PATCH"
+
+echo "=== 4/5 外部归档（校验 SHA-256，缺失才下载） ==="
+mkdir -p "$ARCHIVE_CACHE"
+for pair in $EXPECTED_SHA; do
+  name="${pair%%:*}"; want="${pair##*:}"
+  file="$ARCHIVE_CACHE/$name"
+  if [ ! -f "$file" ]; then
+    test -n "${https_proxy:-}" || { echo "需要 https_proxy 才能补下 $name" >&2; exit 1; }
+    id="${DRIVE_IDS#*$name:}"; id="${id%% *}"
+    echo "缓存缺失，下载 $name"
+    curl -fsSL --retry 3 -x "${https_proxy}" -o "$file" \
+      "https://drive.usercontent.google.com/download?id=${id}&export=download&confirm=t"
+  fi
+  got="$(sha256sum "$file" | cut -d' ' -f1)"
+  [ "$got" = "$want" ] || { echo "$name SHA-256 不符：$got != $want" >&2; exit 1; }
+  echo "ok $name $want"
+done
+python "$REPO/ci/script/prepare_android_dependencies.py" \
+  --profile full --archives "$ARCHIVE_CACHE" --repository "$CLEAN_DIR"
+
+echo "=== 5/5 解包产物再校验 ==="
+check_artifact() {
+  local path="$1" want="$2"
+  local got
+  got="$(sha256sum "$CLEAN_DIR/$path" | cut -d' ' -f1)"
+  [ "$got" = "$want" ] || { echo "$path SHA-256 不符：$got != $want" >&2; exit 1; }
+  echo "ok $path $want"
+}
+check_artifact "app/libs/ffmpeg-kit-local.aar" "b292b0425d3445244832894d3370c46c5b1f80f0b27eb17edb5810b6bc00fffc"
+check_artifact "app/src/main/jniLibs/arm64-v8a/liboperit_ripgrep.so" "71b6e8af8b2c833c85b5119ba0bd0bad05495ce0b9bed68d6e3530cb42a4dad5"
+
+cp "$REPO/local.properties" "$CLEAN_DIR/local.properties"
+
+{
+  echo "materializedAt: $(date -Is)"
+  echo "baseCommit: $BASE_COMMIT"
+  echo "terminalCommit: $TERMINAL_COMMIT"
+  echo "patch: $PATCH $(sha256sum "$PATCH" | cut -d' ' -f1)"
+  echo "terminalPatch: $TERMINAL_PATCH $(sha256sum "$TERMINAL_PATCH" | cut -d' ' -f1)"
+  for pair in $EXPECTED_SHA; do echo "archive ${pair%%:*}: ${pair##*:}"; done
+} > "$CLEAN_DIR/M0-BASELINE.txt"
+
+echo "=== 物化完成：$CLEAN_DIR ==="
+echo "下一步：REPO='$CLEAN_DIR' WORK_ROOT='$WORK_ROOT' bash ci/script/build_m0_local.sh"
