diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 562c695e..d120fc6a 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -356,6 +356,85 @@ val syncMainAssets by tasks.registering(Sync::class) {
     into(generatedMainAssetsDir)
 }
 
+val forbiddenSigningMaterialExtensions = setOf(".jks", ".keystore", ".p12", ".pkcs12", ".pem", ".key")
+val embeddedArchiveExtensions = setOf(".apk", ".zip", ".jar", ".aar")
+
+fun signingMaterialInArchive(archive: File, archiveLabel: String): List<String> {
+    val found = mutableListOf<String>()
+    ZipFile(archive).use { zip ->
+        val entries = zip.entries()
+        while (entries.hasMoreElements()) {
+            val entry = entries.nextElement()
+            if (!entry.isDirectory &&
+                forbiddenSigningMaterialExtensions.any { extension -> entry.name.endsWith(extension, ignoreCase = true) }
+            ) {
+                found.add("$archiveLabel!/${entry.name}")
+            }
+        }
+    }
+    return found
+}
+
+// Library modules are not visible from :app's own srcDirs; AGP only combines their
+// src/main/assets during merge<Variant>Assets. Enumerate every included project so the
+// check sees the packaged set rather than a hand-maintained list of roots.
+val packagedAssetRoots: List<Pair<String, File>> = buildList {
+    add(":app/src/main/assets" to file("src/main/assets"))
+    add(":app/generated-stt-assets" to generatedMainAssetsDir.get().asFile)
+    rootProject.subprojects
+        .filter { subproject -> subproject != project }
+        .map { subproject -> "${subproject.path}/src/main/assets" to subproject.file("src/main/assets") }
+        .filter { (_, candidate) -> candidate.isDirectory }
+        .let { addAll(it) }
+}
+
+fun signingMaterialUnder(assetRoot: File, rootLabel: String): List<String> {
+    if (!assetRoot.isDirectory) {
+        return emptyList()
+    }
+    return assetRoot.walkTopDown()
+        .filter { candidate -> candidate.isFile }
+        .flatMap { candidate ->
+            val relativePath = "$rootLabel/${candidate.relativeTo(assetRoot).path}"
+            val directHits = if (forbiddenSigningMaterialExtensions.any { extension ->
+                    candidate.name.endsWith(extension, ignoreCase = true)
+                }
+            ) {
+                listOf(relativePath)
+            } else {
+                emptyList()
+            }
+            val nestedHits = if (embeddedArchiveExtensions.any { extension ->
+                    candidate.name.endsWith(extension, ignoreCase = true)
+                }
+            ) {
+                signingMaterialInArchive(candidate, relativePath)
+            } else {
+                emptyList()
+            }
+            directHits + nestedHits
+        }
+        .toList()
+}
+
+val verifyNoEmbeddedSigningMaterial by tasks.registering {
+    description = "Prevents private signing material from entering any merged application asset."
+    group = "verification"
+    dependsOn(syncMainAssets)
+    inputs.dir("src/main/assets")
+    inputs.dir(generatedMainAssetsDir)
+    outputs.upToDateWhen { false }
+
+    doLast {
+        val forbiddenFiles = packagedAssetRoots.flatMap { (rootLabel, assetRoot) ->
+            signingMaterialUnder(assetRoot, rootLabel)
+        }
+        require(forbiddenFiles.isEmpty()) {
+            "Signing material must not be embedded in application assets: ${forbiddenFiles.joinToString()}"
+        }
+    }
+}
