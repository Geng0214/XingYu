-    // BouncyCastle - explicitly include jdk18on version to avoid conflicts
+    // BouncyCastle - explicitly include jdk18on versions to avoid conflicts.
+    // bcpkix is required to create the per-install export certificate without embedded keys.
     implementation("org.bouncycastle:bcprov-jdk18on:1.78")
+    implementation("org.bouncycastle:bcpkix-jdk18on:1.78")
 
     // Retrofit
     implementation("com.squareup.retrofit2:retrofit:2.9.0")
