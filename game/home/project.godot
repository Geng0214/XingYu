config_version=5

[application]
config/name="星语家园"
run/main_scene="res://home.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="xingyu-home-renderer"

[display]
window/size/viewport_width=900
window/size/viewport_height=1200
window/stretch/mode="disabled"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.34, 0.48, 0.31, 1)

[audio]
driver/enable_input=false

[xr]
shaders/enabled=false
